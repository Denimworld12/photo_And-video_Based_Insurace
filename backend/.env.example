# ==============================================
# PBI AgriInsure - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret (change this to a strong random string)
JWT_SECRET=your_jwt_secret_here_change_me
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio Configuration (for SMS OTP)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_phone_number

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Python Configuration
PYTHON_COMMAND=python
WEATHER_API_KEY=your_weather_api_key

# File Upload
MAX_FILE_SIZE=52428800

# Admin Configuration
# The phone number granted the admin role at login. There is no built-in
# default: leave this unset and no account is auto-promoted to admin.
ADMIN_PHONE_NUMBER=

# Trust proxy setting. Set this when the API runs behind a load balancer or
# reverse proxy, otherwise rate limiting and audit-log IPs see the proxy's
# address for every client. Accepts a hop count (1), true/false, or a
# comma-separated list of trusted addresses; anything else stops startup.
# TRUST_PROXY=1

# OTP Configuration
# Mock delivery sends no SMS and returns the OTP in the send-otp response so a
# local client can log in. The submitted OTP is still verified in both modes.
# Mock delivery is refused when NODE_ENV=production; set OTP_MOCK_MODE=false and
# configure Twilio before deploying.
#
# NOTE: SMS delivery is NOT implemented yet. The Twilio send block in
# src/services/otp.service.js is still commented out, so with mock delivery off
# send-otp reports success without sending anything and nobody can log in. The
# server prints a warning about this on every production start.
OTP_MOCK_MODE=true

# Google Gemini AI (for claim summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# Claim Threshold Configuration
# Confidence >= APPROVE threshold → auto-approved
# Confidence >= REJECT threshold → manual review
# Confidence < REJECT threshold → auto-rejected
CLAIM_AUTO_APPROVE_THRESHOLD=0.7
CLAIM_REJECT_THRESHOLD=0.3

# Sum insured used when a claim's policy cannot be resolved (INR)
DEFAULT_SUM_INSURED=100000

# How many times a rejected claim may be resubmitted
MAX_RESUBMISSIONS=3

# Milliseconds to wait for the Python analysis pipeline before giving up.
# A timeout sends the claim to manual review, never to an automatic decision.
PYTHON_PIPELINE_TIMEOUT_MS=120000
